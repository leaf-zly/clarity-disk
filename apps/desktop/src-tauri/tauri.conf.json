{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "澄盘",
  "version": "0.1.0",
  "identifier": "com.claritydisk.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "澄盘",
        "width": 1240,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "copyright": "Copyright © 2026 Clarity Disk Contributors",
    "shortDescription": "安全、优雅的 Windows 磁盘管家",
    "longDescription": "Windows 磁盘空间分析、系统清理与分区管理工具",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
